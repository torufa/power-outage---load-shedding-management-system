# ==============================================================================
# GridPulse Environment Configuration Example
# Copy this file to '.env' and fill in the actual values.
# DO NOT commit the actual '.env' file to source control.
# ==============================================================================

# App Configuration
PORT=5000
APP_URL=http://localhost:5000

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/gridpulse_db

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration (For OTP caching, Blacklist, Grid Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5000/payment/success
STRIPE_CANCEL_URL=http://localhost:5000/payment/cancel

# Cloudinary File Storage (Outage evidence photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / SMTP Configuration
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="GridPulse <no-reply@gridpulse.com>"

# Google Cloud Platform (GCP) Social Login
GCP_CLIENT_ID=your_gcp_client_id.apps.googleusercontent.com
GCP_CLIENT_SECRET=your_gcp_client_secret